{
  "name": "@really-bad-apps/pg-podcaster-api",
  "version": "0.0.2",
  "description": "TypeScript client for the Podcast Guru podcaster portal REST API (podcaster.podcastguru.io). Fetch-based; works in browsers and Node.",
  "license": "MIT",
  "author": "Jason Byteforge",
  "repository": {
    "type": "git",
    "url": "https://github.com/Really-Bad-Apps/pg-podcaster-api-ts.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
